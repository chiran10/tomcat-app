apiVersion: apps/v1
kind: Deployment
metadata:
  name: tomcat-app
  namespace: enterprise-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tomcat-app
  template:
    metadata:
      labels:
        app: tomcat-app
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8081"
        prometheus.io/path: "/metrics"
    spec:
      containers:
      - name: tomcat-container
        image: tomcat-app:latest
        imagePullPolicy: Never   # important for local docker
        ports:
        - containerPort: 8080  # tomcat http
        - containerPort: 8081  # JMX metrics
        envFrom:
        - configMapRef:
            name: app-config
         Add JMX Exporter Java agent
        env:
        - name: JAVA_OPTS
          value: "-javaagent:/opt/jmx_exporter/jmx_prometheus_javaagent.jar=8080:/opt/jmx_exporter/config.yaml"
