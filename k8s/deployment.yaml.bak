apiVersion: apps/v1
kind: Deployment
metadata:
  name: tomcat-app
  namespace: enterprise-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tomcat-app
  template:
    metadata:
      labels:
        app: tomcat-app
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/metrics"   # ✅ correct as annotation
    spec:
      containers:
      - name: tomcat-container
        image: tomcat-app:latest
        imagePullPolicy: Never   # important for local docker
        ports:
        - containerPort: 8080
        envFrom:
        - configMapRef:
            name: app-config
